<Window x:Class="PvzLauncherRemake.Windows.WindowOverlayInfo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PvzLauncherRemake.Windows"
        xmlns:icons="clr-namespace:PvzLauncherRemake.Controls.Icons"
        mc:Ignorable="d"
        Title="WindowOverlayInfo" Height="600" Width="800" WindowStyle="None" AllowsTransparency="True" Topmost="True" Background="Transparent" ShowInTaskbar="False">
    <Grid x:Name="grid_root">
        <Grid x:Name="grid_logo" Margin="20" VerticalAlignment="Bottom" HorizontalAlignment="Left">
            <icons:IconApplicationFull MaxHeight="40"/>
        </Grid>
    </Grid>
</Window>
